{
  "name": "cognistore",
  "version": "2.2.2",
  "private": true,
  "description": "Semantic knowledge management for AI agents",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "bump": "bash scripts/bump-version.sh",
    "check:version": "node scripts/check-release-version.mjs",
    "dmg": "pnpm --filter @cognistore/dashboard tauri:dmg",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4"
    }
  }
}
