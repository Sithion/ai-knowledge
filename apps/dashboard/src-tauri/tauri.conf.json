{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "CogniStore",
  "identifier": "com.cognistore.dashboard",
  "version": "../package.json",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://github.com https://api.github.com https://objects.githubusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Sithion/cognistore/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NTk3RTY4Q0QzQzQxREYKUldUZlFUek5hSDVaRmhYVS82Szh0d1VBR2d5UUpwb1pKTU52QXpsajkrZStRelUxSmJLYUd5WVoK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar-bundle/dist": "dist",
      "../sidecar-bundle/dist-server": "dist-server",
      "../sidecar-bundle/node_modules": "node_modules",
      "../templates": "templates",
      "../package.json": "package.json"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
