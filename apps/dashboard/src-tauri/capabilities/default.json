{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-v2-capabilities/refs/heads/main/capabilities.schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "updater:default",
    "process:default",
    "allow-open-widget",
    "allow-close-widget",
    "allow-get-open-widgets",
    "allow-set-provider-secret",
    "allow-delete-provider-secret",
    "allow-cleanup-provider-secrets",
    "allow-set-oauth-tokens",
    "allow-get-oauth-tokens",
    "allow-delete-oauth-tokens",
    "allow-oauth-reserve",
    "allow-oauth-await"
  ]
}
